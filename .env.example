# Copy to .env and edit:  cp .env.example .env
# .env is ignored by git. Never commit real values.

# --- Server (on the VPS) ---------------------------------------------------
# Your real domain. Its A record must point at the VPS.
DOMAIN=vpn.example.com
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# Directory with fullchain.pem and privkey.pem, mounted read-only.
# With the bundled certbot helper this is ./certs.
CERTS_DIR=./certs
# Your cover website (static files). Replace the placeholder before real use.
COVER_DIR=./deploy/cover-site
# Optional traffic profile captured with chamele0nx-profiler (see docs/en/PROFILES.md).
# Leave unset to use the built-in shape.
# PROFILE_FILE=./profiles/mysite.json

# The three values below must be identical on server and client.
# Change them from the defaults: unchanged defaults are a fingerprint.
API_PATH=/api/v1/events
SERVER_ID=chamele0nx-1
COOKIE_FORMAT=wordpress

# Secret: 64 hex chars, kept in a FILE (not here, not in arguments).
#   mkdir -p secrets && openssl rand -hex 32 > secrets/secret && chmod 600 secrets/secret
SECRET_FILE=./secrets/secret

# --- Client (at home) ------------------------------------------------------
# Server address as host:port.
SERVER=vpn.example.com:443
# Local SOCKS5 port. The client listens on 127.0.0.1 only.
SOCKS_PORT=1080
